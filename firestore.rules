rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailStr(email) {
      return email is string
        && email.size() >= 3
        && email.size() <= 128
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 3;
    }

    function isPrimaryAdmin() {
      return isVerifiedUser()
        && request.auth.token.email.lower() == 'sonjg1230@gmail.com';
    }

    function isValidAllowedEmails(emails) {
      return emails is list
        && emails.size() >= 1
        && emails.size() <= 3
        && isValidEmailStr(emails[0])
        && emails[0] == 'sonjg1230@gmail.com'
        && (emails.size() < 2 || isValidEmailStr(emails[1]))
        && (emails.size() < 3 || isValidEmailStr(emails[2]));
    }

    function isValidVault(data, vaultId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'ownerEmail', 'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ownerEmail', 'allowedEmails', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == vaultId
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && isValidEmailStr(data.ownerEmail)
        && data.ownerEmail == 'sonjg1230@gmail.com'
        && isValidAllowedEmails(data.allowedEmails)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVaultItem(data, itemId, vaultId) {
      return data.keys().hasAll([
          'id', 'vaultId', 'ownerId', 'allowedEmails', 'category', 'subType',
          'title', 'url', 'content', 'tags', 'favorite', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'vaultId', 'ownerId', 'allowedEmails', 'category', 'subType',
          'title', 'url', 'content', 'tags', 'favorite', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && isValidId(data.vaultId)
        && data.vaultId == vaultId
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && isValidAllowedEmails(data.allowedEmails)
        && data.category is string
        && data.category in ['idea', 'creation', 'reference']
        && data.subType is string
        && data.subType.size() <= 64
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.url is string
        && data.url.size() <= 2000
        && (data.url == '' || data.url.matches('^https?://.*'))
        && data.content is string
        && data.content.size() <= 20000
        && data.tags is list
        && data.tags.size() <= 10
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.favorite is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isVaultMember(vaultId) {
      return isVerifiedUser() && (
        isPrimaryAdmin()
        || (
          exists(/databases/$(database)/documents/vaults/$(vaultId))
          && get(/databases/$(database)/documents/vaults/$(vaultId)).data.allowedEmails is list
          && request.auth.token.email.lower() in get(/databases/$(database)/documents/vaults/$(vaultId)).data.allowedEmails
        )
      );
    }

    match /vaults/{vaultId} {
      allow get: if isVerifiedUser() && isValidId(vaultId) && (
        isPrimaryAdmin()
        || (
          resource != null
          && existing().allowedEmails is list
          && request.auth.token.email.lower() in existing().allowedEmails
        )
      );

      allow create: if isPrimaryAdmin()
        && isValidId(vaultId)
        && isValidVault(incoming(), vaultId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isPrimaryAdmin()
        && isValidId(vaultId)
        && isValidVault(incoming(), vaultId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().ownerEmail == existing().ownerEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['allowedEmails', 'updatedAt']);

      allow delete: if false;

      match /items/{itemId} {
        allow get: if isVerifiedUser() && isValidId(vaultId) && isValidId(itemId) && isVaultMember(vaultId);

        allow list: if isVerifiedUser()
          && resource.data.allowedEmails is list
          && request.auth.token.email.lower() in resource.data.allowedEmails;

        allow create: if isVerifiedUser()
          && isValidId(vaultId)
          && isValidId(itemId)
          && isValidVaultItem(incoming(), itemId, vaultId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isVaultMember(vaultId)
          && exists(/databases/$(database)/documents/vaults/$(vaultId))
          && incoming().allowedEmails == get(/databases/$(database)/documents/vaults/$(vaultId)).data.allowedEmails;

        allow update: if isVerifiedUser()
          && isValidId(vaultId)
          && isValidId(itemId)
          && isValidVaultItem(incoming(), itemId, vaultId)
          && incoming().id == existing().id
          && incoming().vaultId == existing().vaultId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isVaultMember(vaultId)
          && (
            // Action 1: Toggle favorite
            (
              incoming().allowedEmails == existing().allowedEmails
              && incoming().diff(existing()).affectedKeys().hasOnly(['favorite', 'updatedAt'])
            )
            ||
            // Action 2: Edit item details / promote / AI expand
            (
              incoming().allowedEmails == existing().allowedEmails
              && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'subType', 'title', 'url', 'content', 'tags', 'updatedAt'])
            )
            ||
            // Action 3: Sync shared allowlist from parent vault (primary admin only)
            (
              isPrimaryAdmin()
              && exists(/databases/$(database)/documents/vaults/$(vaultId))
              && incoming().allowedEmails == get(/databases/$(database)/documents/vaults/$(vaultId)).data.allowedEmails
              && incoming().diff(existing()).affectedKeys().hasOnly(['allowedEmails', 'updatedAt'])
            )
          );

        allow delete: if isVerifiedUser() && isValidId(vaultId) && isValidId(itemId) && isVaultMember(vaultId);
      }
    }
  }
}
